# ═══════════════════════════════════════════════════════════════════════════════
# Mercant AI — Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════════════
# 1. Copy this file:  cp .env.example .env.local
# 2. Fill in ALL values marked with <...>
# 3. NEVER commit .env or .env.local — they are in .gitignore
#
# For Cloudflare Pages: paste each variable in:
#   Dashboard → Workers & Pages → mercant → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────────────────────
# LOCAL (SQLite, zero-config):
DATABASE_URL="file:./dev.db"

# PRODUCTION (use a hosted Postgres — Supabase free tier works great):
# DATABASE_URL="postgresql://postgres.<ref>:<password>@<host>:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@<host>:5432/postgres"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="<generate-with-openssl-rand-base64-32>"
# Local dev:
NEXTAUTH_URL="http://localhost:3000"
# Production (your Cloudflare Pages domain):
# NEXTAUTH_URL="https://mercant.pages.dev"

# ─── AI Provider — NVIDIA NIM ─────────────────────────────────────────────────
# Get your key at: https://integrate.api.nvidia.com
NVIDIA_API_KEY="<your-nvidia-api-key>"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="moonshotai/kimi-k3"

# ─── Connectors (optional) ────────────────────────────────────────────────────
# SerpAPI — Google Shopping results (100 free/month)
# Get from: https://serpapi.com/dashboard
SERPAPI_KEY=""

# ─── App Config ───────────────────────────────────────────────────────────────
DEFAULT_CURRENCY="MXN"
DEMO_MODE="false"

# ─── Stripe (optional, for paid plans) ───────────────────────────────────────
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
