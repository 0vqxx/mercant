generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id               String          @id @default(cuid())
  name             String?
  email            String?         @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  defaultCurrency  String          @default("MXN")
  defaultPriority  String          @default("BALANCE")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  accounts         Account[]
  sessions         Session[]
  procurements     Procurement[]
  trackingJobs     PriceTracking[]
  plan             String          @default("FREE") // FREE, PRO, ENTERPRISE
  planExpiresAt    DateTime?
  stripeCustomerId String?
  stripeSubId      String?
  usedPromoCodes   PromoCodeUsage[]
  supportTickets   SupportTicket[]
}

model SupportTicket {
  id          String    @id @default(cuid())
  ticketId    String    @unique // e.g. TCK-2026-12345
  userId      String?
  name        String
  email       String
  subject     String
  category    String    @default("other")
  message     String
  status      String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  submittedAt DateTime  @default(now())
  resolvedAt  DateTime?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Procurement {
  id            String            @id @default(cuid())
  userId        String
  name          String
  status        String            @default("DRAFT")
  budget        Float?
  currency      String            @default("MXN")
  priorityMode  String            @default("BALANCE")
  notes         String?
  rawInput      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  completedAt   DateTime?
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         ProcurementItem[]
}

model ProcurementItem {
  id              String        @id @default(cuid())
  procurementId   String
  name            String
  brand           String?
  model           String?
  sku             String?
  quantity        Int           @default(1)
  specifications  String?
  maxBudget       Float?
  currency        String        @default("MXN")
  status          String        @default("PENDING")
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  procurement     Procurement   @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  searchResults   SearchResult[]
  offers          NormalizedOffer[]
  trackingJobs    PriceTracking[]
}

model SearchResult {
  id              String          @id @default(cuid())
  itemId          String
  connectorId     String
  isDemo          Boolean         @default(false)
  sourceUrl       String
  sourceName      String
  rawTitle        String
  rawPrice        Float?
  rawCurrency     String          @default("MXN")
  rawAvailability String?
  rawShipping     Float?
  rawImageUrl     String?
  rawRating       Float?
  rawReviewCount  Int?
  rawSeller       String?
  rawData         String?
  queriedAt       DateTime        @default(now())
  item            ProcurementItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  offer           NormalizedOffer?
}

model NormalizedOffer {
  id                String          @id @default(cuid())
  itemId            String
  searchResultId    String          @unique
  connectorId       String
  isDemo            Boolean         @default(false)
  supplierDomain    String
  supplierName      String
  productTitle      String
  brand             String?
  model             String?
  sku               String?
  unitPrice         Float
  currency          String          @default("MXN")
  quantity          Int             @default(1)
  totalPrice        Float
  shippingCost      Float?
  shippingAvailable Boolean         @default(true)
  estimatedDays     Int?
  availability      String          @default("UNKNOWN")
  sourceUrl         String
  imageUrl          String?
  trustScore        Int?
  trustCategory     String?
  trustBreakdown    String?
  trustExplanation  String?
  buyingScore       Int?
  buyingBreakdown   String?
  matchScore        Float?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  item              ProcurementItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  searchResult      SearchResult    @relation(fields: [searchResultId], references: [id], onDelete: Cascade)
  alerts            Alert[]
  priceHistory      PriceHistory[]
}

model Alert {
  id        String      @id @default(cuid())
  offerId   String
  type      String
  severity  String
  message   String
  detail    String?
  createdAt DateTime    @default(now())
  offer     NormalizedOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
}

model PriceTracking {
  id            String          @id @default(cuid())
  userId        String
  itemId        String
  targetPrice   Float?
  currency      String          @default("MXN")
  isActive      Boolean         @default(true)
  lastCheckedAt DateTime?
  nextCheckAt   DateTime?
  frequency     String          @default("DAILY")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  item          ProcurementItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  history       PriceHistory[]
}

model PriceHistory {
  id          String          @id @default(cuid())
  trackingId  String
  offerId     String
  price       Float
  currency    String          @default("MXN")
  availability String         @default("UNKNOWN")
  checkedAt   DateTime        @default(now())
  tracking    PriceTracking   @relation(fields: [trackingId], references: [id], onDelete: Cascade)
  offer       NormalizedOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
}

model PromoCode {
  id          String           @id @default(cuid())
  code        String           @unique
  plan        String           @default("PRO")
  durationDays Int             @default(30)
  maxUses     Int             @default(10)
  currentUses Int             @default(0)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  usages      PromoCodeUsage[]
}

model PromoCodeUsage {
  id          String    @id @default(cuid())
  promoCodeId String
  userId      String
  usedAt      DateTime @default(now())
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, userId])
}
